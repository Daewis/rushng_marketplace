{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build --webpack",
  "installCommand": "bun install",
  "regions": ["iad1"],
  "env": {
    "MONGODB_DB": "rush"
  },
  "crons": []
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://firebaseapp.com*"
    }
  ]
}
